  "larabanga-mosque": {
    "title": "Larabanga Mosque",
    "extract": "The Larabanga Mosque is a mosque built in the Sudanese architectural style in the village of Larabanga, Savanna Region of Ghana. It is the oldest mosque in the country and one of the oldest in West Africa, and has been referred to as the \"Mecca of West Africa\". The mosque has undergone restoration several times since it was founded in 1421 CE; most recently in 2023. The World Monuments Fund (WMF) has contributed substantially to its restoration and lists it as one of the 100 Most Endangered Sites. The restoration works have revived the knowledge of adobe maintenance.",
    "wikipediaUrl": "https://en.wikipedia.org/wiki/Larabanga_Mosque",
    "coordinates": {
      "lat": 9.2203,
      "lon": -1.8599
    },
